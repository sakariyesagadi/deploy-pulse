# GitHub API — a personal access token with `repo` (or `actions:read`) scope.
# In GitHub Actions this is provided automatically as ${{ secrets.GITHUB_TOKEN }}.
GITHUB_TOKEN=ghp_your_personal_access_token

# Slack incoming webhook URL for the weekly digest (optional).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# SendGrid API key for email digests (optional).
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Path to the config file (defaults to config.yml).
DEPLOY_PULSE_CONFIG=config.yml

# Path to the SQLite database (defaults to deploy_pulse.db).
DEPLOY_PULSE_DB=deploy_pulse.db
